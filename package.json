{
  "name": "as-free",
  "version": "0.0.0",
  "description": "Type-preserving utilities so your code needs no `as`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9wick/as-free.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./runtime": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepare": "vp config",
    "check:dist": "vp pack && tsc -p tsconfig.dist.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.26.0"
}
